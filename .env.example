# ============================================================================
# TechNova IT Store — Environment Configuration Template (.env.example)
# ============================================================================
# Duplicate this file as .env and fill in your actual production values.

# Server Port
PORT=3000

# Environment mode ('development' or 'production')
NODE_ENV=development

# Session Encryption Secret (Required: Min 32 characters random string)
SESSION_SECRET=replace_with_a_secure_random_32_character_string_for_production

# Optional SQLite Database Path Override
DATABASE_URL=./db/store.sqlite

# Recommended for Cloud Hosting (Render / Vercel / Production): Brevo HTTPS REST API (No domain restrictions)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your-email@gmail.com
BREVO_SENDER_NAME=TechNova IT Store

# Optional: Resend HTTPS API
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=TechNova IT <onboarding@resend.dev>

# Optional: Gmail SMTP Credentials (Fallback)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your16digitapppass

# Canonical Website URL (Used in password reset email links)
SITE_URL=http://localhost:3000
